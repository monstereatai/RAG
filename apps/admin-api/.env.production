# Production Environment Configuration
NODE_ENV=production
PORT=3001
HTTPS_ENABLED=true

# Database Configuration
DB_HOST=prod-db-master.example.com
DB_PORT=3306
DB_USERNAME=nestjs_user
DB_PASSWORD=${DB_PASSWORD}
DB_DATABASE=nestjs_enterprise_prod
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Master Database (for read-write splitting)
MASTER_DB_HOST=prod-db-master.example.com
MASTER_DB_PORT=3306
MASTER_DB_USERNAME=nestjs_user
MASTER_DB_PASSWORD=${DB_PASSWORD}
MASTER_DB_DATABASE=nestjs_enterprise_prod_master

# Slave Database (for read-write splitting)
SLAVE_DB_HOST=prod-db-slave.example.com
SLAVE_DB_PORT=3306
SLAVE_DB_USERNAME=nestjs_user
SLAVE_DB_PASSWORD=${DB_PASSWORD}
SLAVE_DB_DATABASE=nestjs_enterprise_prod_slave

# Redis Configuration
REDIS_HOST=prod-redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=24h
REFRESH_SECRET=${REFRESH_SECRET}
REFRESH_EXPIRES_IN=7d

# RabbitMQ Configuration
RABBITMQ_URL=amqp://${RABBITMQ_USERNAME}:${RABBITMQ_PASSWORD}@prod-rabbitmq.example.com:5672
RABBITMQ_HOST=prod-rabbitmq.example.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=${RABBITMQ_USERNAME}
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_CREDENTIALS=true

# Security Configuration
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
MAX_SLAVE_LAG=3000
ENCRYPTION_ALGORITHM=aes-256-cbc
SESSION_SECRET=${SESSION_SECRET}

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/nestjs/app.log

# RabbitMQ Alternative (using Bull)
# BULL_REDIS_URL=redis://prod-redis.example.com:6379/1

# Health Check
HEALTH_ENABLED=true


{
  "rootDir": "../backend/src",
  "modulePaths": [
    "<rootDir>/../node_modules"
  ],
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testRegex": ".*\\.spec\\.ts$",
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/test/mocks/uuid.cjs"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "<rootDir>/../node_modules/.pnpm/jest-environment-node@30.4.1/node_modules/jest-environment-node"
}

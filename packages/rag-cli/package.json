{
  "name": "rag-cli",
  "version": "0.1.0",
  "description": "Command line gateway for RAG knowledge search, Q&A, and coding context packages.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "rag": "./dist/src/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/bin.js"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}

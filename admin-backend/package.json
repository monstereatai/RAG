{
  "name": "admin-backend",
  "version": "1.0.0",
  "description": "Admin backend service for enterprise knowledge base operations",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm run build && node dist/main.js",
    "start:dev": "nest start --watch --path tsconfig.dev.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --detectOpenHandles",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand --detectOpenHandles",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "verify": "npm run build && npm run lint && npm test -- --runInBand && npm run test:e2e -- --runInBand && npm run migration:check",
    "verify:ci": "npm run build && npm run lint && npm run test:cov -- --runInBand --silent && npm run test:e2e -- --runInBand && npm run migration:check",
    "verify:integration": "INTEGRATION_TESTS=true npm run test:integration && node scripts/integration-smoke.js",
    "audit:high": "pnpm audit --omit=dev --audit-level=high",
    "perf:smoke": "node scripts/perf-smoke.js",
    "perf:k6": "k6 run perf/load-test.js",
    "migration:check": "node scripts/check-migrations.js",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate src/database/migrations/Migration",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert"
  },
  "keywords": [
    "nestjs",
    "enterprise",
    "admin-backend"
  ],
  "author": "monstereat",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs-modules/mailer": "2.3.7",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/microservices": "11.1.27",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/typeorm": "11.0.2",
    "@nestjs/websockets": "10.4.22",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@types/amqplib": "0.10.8",
    "@types/bull": "3.15.9",
    "@types/dompurify": "3.2.0",
    "@types/express-rate-limit": "5.1.3",
    "@types/ioredis": "4.28.10",
    "amqplib": "2.0.1",
    "bcryptjs": "3.0.3",
    "bull": "4.16.5",
    "cache-manager": "7.2.8",
    "cache-manager-ioredis": "2.1.0",
    "cache-manager-redis-yet": "5.1.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dompurify": "3.4.11",
    "dotenv": "17.4.2",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "ioredis": "5.11.1",
    "multer": "2.2.0",
    "mysql2": "3.22.5",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.0.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "typeorm": "0.3.30",
    "validator": "13.15.35",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/multer": "2.1.0",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.1",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "2.0.16",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 6,
        "functions": 8,
        "lines": 7,
        "statements": 7
      }
    }
  }
}

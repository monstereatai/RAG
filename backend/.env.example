# ============================================================
# RAG 项目环境变量模板
# 复制为 .env 并填入真实密钥（.env 不进 git）
# ============================================================

# ---- 应用 ----
NODE_ENV=development
PORT=3000

# ---- 认证（JWT）----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- API 限流 ----
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ---- 向量库（可插拔：milvus | pgvector）----
VECTOR_STORE_PROVIDER=milvus

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks
MILVUS_DIMENSION=1024

# pgvector（备选）
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/rag
PGVECTOR_TABLE=rag_chunks

# ---- 关系型数据库（可插拔：postgres | mysql）----
RELATIONAL_DB_PROVIDER=postgres

# PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/rag

# MySQL（备选）
MYSQL_URL=mysql://root:root@localhost:3306/rag

# ---- Redis（对话历史 + 缓存）----
REDIS_URL=redis://localhost:6379

# ---- Elasticsearch（全文检索）----
ES_NODE=http://localhost:9200
ES_API_KEY=

# ---- LLM（通义千问 + OpenAI 兼容）----
LLM_PROVIDER=qwen

# 通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI（备选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Embedding ----
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# ---- 语音（腾讯云 ASR/TTS）----
SPEECH_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-shanghai

# ---- 搜索工具（Bocha）----
BOCHA_API_KEY=

# ---- Rerank（DashScope）----
RERANK_PROVIDER=dashscope
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-api/v1/reranks

# ---- 知识图谱（Neo4j，可选）----
GRAPH_RAG_ENABLED=false
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Mem0 长期记忆（可插拔：cloud | local | 禁用）----
MEM0_ENABLED=false
MEM0_PROVIDER=cloud
MEM0_API_KEY=
# 本地部署时使用（MEM0_PROVIDER=local）
MEM0_BASE_URL=

# ---- MCP 工具协议（默认关闭）----
MCP_ENABLED=false
MCP_CONFIG_PATH=

# ---- 工作区 ----
UPLOAD_DIR=

# ---- Skills 技能系统 ----
SKILLS_DIR=

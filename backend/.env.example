# ============================================================
# RAG 项目环境变量模板
# 复制为 .env 并填入真实密钥（.env 不进 git）
# ============================================================

# ---- 应用 ----
NODE_ENV=development
PORT=3000

# ---- 认证（JWT）----
JWT_SECRET=
# access token（业务访问）有效期，默认 2h
JWT_ACCESS_EXPIRES=2h
# refresh token（仅用于 /auth/refresh 换发）有效期，默认 7d
JWT_REFRESH_EXPIRES=7d
# refresh token 独立签名密钥，未配置时回落 JWT_SECRET；生产环境建议与 JWT_SECRET 不同
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d

# ---- 认证（注册 / 邮箱激活 / 重置密码）----
# 登录是否强制邮箱已激活（默认 true）；本地快速演示可设为 false 跳过激活环节
AUTH_REQUIRE_EMAIL_VERIFIED=true
# 激活邮件里链接的站点地址（拼接 /api/v1/auth/verify-email?token=...），默认本机 3000 端口
AUTH_EMAIL_LINK_BASE_URL=http://localhost:3000

# ---- 邮件（SMTP；未配置时自动进入本地模拟模式）----
# 四项（HOST/PORT/USER/PASS）任一未配置即视为未配置 SMTP：
# 邮件不会真实发送，完整内容（收件人/主题/正文/时间）覆盖写入 workspace/mail-outbox/latest.json
# 并追加 outbox.jsonl，同时输出 [simulated] 日志，便于本地演示与冒烟测试断言
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
# 发件人（如 "企业知识库 <no-reply@example.com>"），未配置时回落 MAIL_USER
MAIL_FROM=

# ---- API 限流 ----
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ---- 向量库（可插拔：milvus | pgvector）----
VECTOR_STORE_PROVIDER=milvus

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks
MILVUS_DIMENSION=1024
MILVUS_INDEX_TYPE=HNSW
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF_SEARCH=64
MILVUS_SEARCH_TIMEOUT_MS=800
MILVUS_DELETE_TIMEOUT_MS=1000
MILVUS_WARMUP_TIMEOUT_MS=1500
MILVUS_CIRCUIT_OPEN_MS=30000
MILVUS_CIRCUIT_FAILURE_THRESHOLD=2
# 图片独立集合（以图搜图 / 文搜图）：维度默认取 MULTIMODAL_EMBEDDING_DIM
MILVUS_IMAGE_COLLECTION=rag_images
MILVUS_IMAGE_DIMENSION=1024

# pgvector（备选）
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/rag
PGVECTOR_TABLE=rag_chunks

# ---- 关系型数据库（可插拔：postgres | mysql）----
RELATIONAL_DB_PROVIDER=postgres

# PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/rag
TYPEORM_SYNCHRONIZE=false

# MySQL（备选）
MYSQL_URL=mysql://root:root@localhost:3306/rag

# ---- Redis（对话历史 + 缓存）----
REDIS_URL=redis://localhost:6379

# ---- 对象存储（原始文件 / 解析资源）----
# local：落到 workspace/object-storage；minio：写入 MinIO
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=127.0.0.1
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=rag-documents
OBJECT_STORAGE_PUBLIC_BASE_URL=

# ---- URL 文档抽取 ----
# 默认静态 fetch；启用后会尝试用 Playwright 渲染 SPA/动态网页，失败时自动降级为静态抽取。
URL_EXTRACT_DYNAMIC_ENABLED=false
URL_EXTRACT_DYNAMIC_REQUIRED=false
URL_EXTRACT_DYNAMIC_TIMEOUT_MS=15000
URL_EXTRACT_DYNAMIC_WAIT_UNTIL=networkidle
URL_EXTRACT_DYNAMIC_SETTLE_MS=500

# ---- Elasticsearch（全文检索）----
ES_NODE=http://localhost:9200
ES_API_KEY=
# rag_chunks 索引 dense_vector 向量字段维度（kNN 检索用），必须与嵌入模型输出维度一致：
# 默认 1024（text-embedding-v3 为 1024 维）；更换嵌入模型时需同步修改并重建/补齐 ES mapping
RAG_ES_EMBEDDING_DIM=1024
# ES kNN 向量通道模式（rag_chunks.embedding 的 dense_vector kNN 检索）：
# off      = 关闭，向量只走 Milvus，行为与旧版完全一致
# fallback = Milvus 不可用/调用失败时，用 ES kNN 作为向量降级通道（默认；单 ES 也能跑混合检索）
# always   = Milvus 与 ES kNN 两路向量并行召回，按 chunk id 去重合并进融合池
RAG_ES_KNN_MODE=fallback

# ---- LLM（通义千问 / DeepSeek / 智谱 + OpenAI 兼容）----
LLM_PROVIDER=qwen
LLM_GATEWAY_FALLBACK_ENABLED=true
LLM_GATEWAY_FALLBACK_PROVIDER=deepseek
LLM_FAST_TIMEOUT_MS=30000
LLM_FAST_MAX_TOKENS=2048
LLM_FAST_MAX_COST_USD=0.05
LLM_REASONING_TIMEOUT_MS=60000
LLM_REASONING_MAX_TOKENS=4096
LLM_REASONING_MAX_COST_USD=0.10

# 通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_MS=60000
QWEN_MAX_TOKENS=4096
QWEN_MAX_RETRIES=2
QWEN_TEMPERATURE=0.2

# DeepSeek（后台 AI 问答可切换；默认仍使用 Qwen）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_TEMPERATURE=0.2

# 智谱 GLM（OpenAI 兼容；填写 ZHIPU_API_KEY 或 ZAI_API_KEY 二选一）
# 使用时设置 LLM_PROVIDER=zhipu；默认模型可按账号可用范围调整。
ZHIPU_API_KEY=
ZAI_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.2
ZHIPU_TIMEOUT_MS=60000
ZHIPU_MAX_TOKENS=4096
ZHIPU_MAX_RETRIES=2
ZHIPU_TEMPERATURE=0.2

# OpenAI（备选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Embedding ----
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# ---- 多模态嵌入（DashScope multimodal-embedding，以图搜图 / 文搜图）----
# 文本与图片映射到同一向量空间；未配置 Key 时图片检索自动降级（返回空结果）
# 模型：multimodal-embedding-v1（固定 1024 维）；如换 qwen3-vl-embedding 需同步调整 DIM
MULTIMODAL_EMBEDDING_MODEL=multimodal-embedding-v1
MULTIMODAL_EMBEDDING_DIM=1024
# 独立 API Key，未设置时回落 DASHSCOPE_API_KEY
MULTIMODAL_EMBEDDING_API_KEY=
# API 基地址（默认阿里云百炼北京区域）
MULTIMODAL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com

# ---- 语音（腾讯云 ASR/TTS）----
SPEECH_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-shanghai

# ---- 搜索工具（Bocha）----
BOCHA_API_KEY=

# ---- Rerank（DashScope）----
RERANK_PROVIDER=dashscope
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 主管线（karpathy 混合检索）精排总开关：false 时直接跳过重排；未配置 RERANK_API_KEY 或调用失败时保持原序不阻断
RAG_RERANK_ENABLED=true
# 送 DashScope 重排的候选数上限（取融合排序前 N 个），重排后按重排分重新排序并挂 rerankScore
RAG_RERANK_TOP_N=20

# ---- 视觉 / 视频理解（可选）----
# 真实 OCR、视频理解、视觉向量检索接入时配置；未配置时仅保留媒体资源和转写 sidecar。
VISION_PROVIDER=
VISION_API_KEY=
QWEN_VL_API_KEY=
VISION_VIDEO_REQUIRE_PROVIDER=false

# ---- 扫描件 PDF 兜底 OCR（复用视觉 provider）----
# 扫描件判定阈值：全文低于 PDF_SCANNED_MIN_TOTAL_CHARS 或平均每页低于 PDF_SCANNED_MIN_CHARS_PER_PAGE 视为无文本层
PDF_SCANNED_MIN_TOTAL_CHARS=50
PDF_SCANNED_MIN_CHARS_PER_PAGE=10
# OCR 渲染与调用上限
PDF_OCR_MAX_PAGES=20
PDF_OCR_CONCURRENCY=3
PDF_OCR_DPI=150

# ---- 文档治理 ----
# 内嵌图片提取总开关（false/0/off/no 关闭）
DOCUMENT_EXTRACT_IMAGES=true
# 单份 PDF 内嵌图总数上限 / PPTX 内嵌图总数上限 / Vision 生成 alt 描述的张数上限
PDF_IMAGE_MAX_COUNT=30
DOCUMENT_IMAGE_MAX_COUNT=30
DOCUMENT_IMAGE_ALT_MAX_COUNT=10
# 审批门禁：true 时新文档一律先落 draft（不进任何检索口径），由管理后台审核提升后生效
DOCUMENT_REQUIRE_APPROVAL=false

# ---- RAG 质量闸门 ----
RAG_MIN_TOP_SCORE=0.05
# 有重排结果时，达到该语义相关度即可通过检索充分性门禁；未返回重排分时仍使用词面门禁。
RAG_MIN_RERANK_SCORE=0.65
RAG_MIN_QUERY_TOKEN_OVERLAP=1
RAG_MIN_CITATION_COVERAGE=0.15
# Simple 受治理 Karpathy 直答的最低问题关键词覆盖度
RAG_KARPATHY_DIRECT_COVERAGE=0.7
# 可选：按 docId 或 chunk 内容匹配来源权重，格式 pattern:weight,pattern:weight
# 示例：official:1.2,draft:0.8
RAG_SOURCE_AUTHORITY_RULES=

# ---- Agentic RAG 成本与复杂度边界 ----
AGENTIC_CONFIDENCE_THRESHOLD=0.7
AGENTIC_MAX_RETRIES=2
AGENTIC_MAX_AUGMENTED_QUERIES=3
AGENTIC_MAX_RETRIEVAL_QUERIES=4
AGENTIC_MAX_SUB_QUESTIONS=3
AGENTIC_MAX_RETRIEVED_CHUNKS=5
AGENTIC_MAX_WEB_SEARCH_RESULTS=5
AGENTIC_MAX_RERANK_TOP_N=5
AGENTIC_MAX_AUTO_QUERY_LENGTH=500
AGENTIC_WEB_SEARCH_FALLBACK_ENABLED=true
AGENTIC_RERANK_ENABLED=true
AGENTIC_GRAPH_SEARCH_ENABLED=true

# ---- RAG LLM-as-Judge 评测（可选，显式运行 eval:rag:judge 时使用）----
EVAL_RAG_JUDGE_MODEL=qwen-plus
EVAL_RAG_JUDGE_MIN_SUPPORTED_RATE=0.9
EVAL_RAG_JUDGE_MAX_CLAIMS=20
# true 时 `npm run eval:rag:quality` 会强制执行 LLM-as-Judge；默认 false 避免每次门禁消耗 key
EVAL_RAG_JUDGE_REQUIRED=false

# ---- LangSmith 追踪与评测导出（可选）----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-evaluation
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_DATASET=rag-smoke
LANGSMITH_EXPERIMENT=rag-smoke-local
# 默认只生成本地导出；设为 true 时调用 LangSmith upload-experiment API
LANGSMITH_UPLOAD=false
# true 时上传失败会让 eval:rag:langsmith 退出码为 1，适合 CI 严格门禁
LANGSMITH_UPLOAD_REQUIRED=false

# ---- LangFuse 线上观测（可选）----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_INPUT_COST_USD_PER_1K=0
LANGFUSE_OUTPUT_COST_USD_PER_1K=0

# ---- 知识图谱（Neo4j，可选）----
GRAPH_RAG_ENABLED=false
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Mem0 长期记忆（可插拔：cloud | local | 禁用）----
MEM0_ENABLED=false
MEM0_PROVIDER=cloud
MEM0_API_KEY=
# 本地部署时使用（MEM0_PROVIDER=local）
MEM0_BASE_URL=

# ---- MCP 工具协议（默认关闭）----
MCP_ENABLED=false
MCP_CONFIG_PATH=

# ---- 工作区 ----
UPLOAD_DIR=

# ---- 内部服务通信 ----
RAG_SERVICE_TOKEN=

# ---- Skills 技能系统 ----
SKILLS_DIR=

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-163cf272-948b-4f31-8947-14983a550ee5
LANGFUSE_SECRET_KEY=sk-lf-f60f37f8-bc9b-4405-b5db-83d8e2996526
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

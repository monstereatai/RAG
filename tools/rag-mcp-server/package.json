{
  "name": "rag-mcp-server",
  "version": "0.1.0",
  "description": "MCP stdio server that exposes RAG knowledge tools for AI coding agents.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "rag-mcp-server": "./dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
